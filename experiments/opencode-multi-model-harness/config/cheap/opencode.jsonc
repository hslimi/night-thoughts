{
  "$schema": "https://opencode.ai/config.json",

  // GLM orchestrates. Qwen and DeepSeek do the delegated work.
  "model": "openrouter/z-ai/glm-5.3-flash",

  "plugins": [
    "opencode-model-router@2.9.1",
    "opencode-runtime-fallback@0.3.1"
  ],

  // Capped so that deepseek/deepseek-flash meets the output floor as GLM's first backup.
  "provider": {
    "openrouter": {
      "models": {
        "z-ai/glm-5.3-flash": { "limit": { "context": 1048576, "output": 393216 } }
      }
    }
  },

  "default_agent": "build",

  "compaction": {
    "auto": true,
    "keep": { "tokens": 20000 },
    "buffer": "20%"
  },

  "agents": {
    "title": { "model": "openrouter/deepseek/deepseek-v4.1-flash" }
  },

  // Ordered rules: the last matching rule wins.
  "permissions": [
    { "action": "shell", "resource": "*", "effect": "ask" },
    { "action": "shell", "resource": "git status *", "effect": "allow" },
    { "action": "shell", "resource": "git diff *", "effect": "allow" },
    { "action": "shell", "resource": "git push *", "effect": "deny" },
    { "action": "shell", "resource": "git reset --hard *", "effect": "deny" },
    { "action": "shell", "resource": "rm -rf *", "effect": "deny" }
  ]
}
